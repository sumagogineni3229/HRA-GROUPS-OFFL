// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?  @default("Administrator")
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactInquiry {
  id        String   @id @default(uuid())
  firstName String
  lastName  String?
  email     String
  message   String
  status    String   @default("New")
  createdAt DateTime @default(now())
}

model GalleryItem {
  id        String   @id @default(uuid())
  title     String
  desc      String?
  src       String
  category  String   @default("All")
  tag       String?
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(uuid())
  title     String
  excerpt   String
  content   String?
  category  String   @default("Blogs")
  service   String   @default("IT Managed Services")
  industry  String   @default("Government")
  readTime  String   @default("5 min read")
  image     String
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String   @id @default(uuid())
  title       String
  badge       String   @default("Specialization")
  description String
  syllabus    String[]
  images      String[]
  duration    String?  @default("4 Months")
  level       String?  @default("Intermediate")
  color       String?  @default("from-blue-600 to-indigo-700")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id               String   @id @default(uuid())
  holderName       String
  certificateId    String   @unique
  password         String
  courseName       String
  issueDate        String
  grade            String?  @default("A+")
  status           String   @default("Verified")
  certificateUrl   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CareerRole {
  id          String   @id @default(uuid())
  title       String
  dept        String   @default("Engineering")
  location    String   @default("Hyderabad, India")
  type        String   @default("Full-Time")
  experience  String   @default("1–3 Years")
  desc        String
  applyLink   String?
  tags        String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications CareerApplication[]
}

model CareerApplication {
  id             String      @id @default(uuid())
  careerRoleId   String?
  careerRole     CareerRole? @relation(fields: [careerRoleId], references: [id], onDelete: SetNull)
  roleTitle      String
  fullName       String
  email          String
  phone          String
  location       String?
  experience     String?
  expectedCtc    String?
  noticePeriod   String?
  skills         String?
  resumeUrl      String?
  coverLetter    String?
  status         String      @default("New")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Assessment {
  id           String           @id @default(uuid())
  title        String
  category     String           @default("Technical Assessment")
  courseCohort String?          @default("General Cohort")
  examKey      String           @unique
  durationMins Int              @default(45)
  passScorePct Int              @default(70)
  description  String?
  questions    Json             // Array of { id, text, options: string[], correctOptionIndex: number, points: number }
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  submissions  ExamSubmission[]
}

model ExamSubmission {
  id             String      @id @default(uuid())
  assessmentId   String
  assessment     Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  candidateId    String      // e.g. HRA-2026-8891 or Candidate Roll
  candidateName  String
  candidateEmail String?
  answers        Json        // Object mapping questionId -> selectedOptionIndex
  score          Int
  totalPoints    Int
  percentage     Float
  status         String      // "PASSED" | "FAILED"
  timeSpentSecs  Int?
  submittedAt    DateTime    @default(now())
}

model InternshipTrack {
  id           String                  @id @default(uuid())
  title        String
  category     String                  @default("technology") // technology | creative | business
  description  String
  duration     String?                 @default("3–6 Months")
  mode         String?                 @default("Hybrid / Remote")
  tags         String[]
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  applications InternshipApplication[]
}

model InternshipApplication {
  id                String           @id @default(uuid())
  internshipTrackId String?
  internshipTrack   InternshipTrack? @relation(fields: [internshipTrackId], references: [id], onDelete: SetNull)
  domainTitle       String
  fullName          String
  email             String
  phone             String
  college           String
  message           String?
  status            String           @default("New") // New | Under Review | Accepted | Shortlisted | Rejected
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model CourseInquiry {
  id          String   @id @default(uuid())
  courseName  String
  fullName    String
  email       String
  phone       String
  message     String?
  status      String   @default("New") // New | In Progress | Enrolled | Closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FounderApplication {
  id          String   @id @default(uuid())
  fullName    String
  email       String
  phone       String
  location    String?
  designation String?
  company     String?
  industry    String?
  website     String?
  business    String
  goals       String?
  interests   String[]
  status      String   @default("New") // New | Under Review | Connected | Archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
